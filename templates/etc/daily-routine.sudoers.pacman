# linux-media-setup: sudo rules for the nightly maintenance routine (Arch family).
# Scoped to exactly the commands daily-routine.sh runs; nothing else.
{{DASH_USER}} ALL=(root) NOPASSWD: /usr/bin/pacman -Syu --noconfirm
{{DASH_USER}} ALL=(root) NOPASSWD: /usr/bin/paccache -rk2
{{DASH_USER}} ALL=(root) NOPASSWD: /usr/bin/smartctl -H -A /dev/disk/by-id/*
{{DASH_USER}} ALL=(root) NOPASSWD: /usr/bin/journalctl --vacuum-time=*
{{DASH_USER}} ALL=(root) NOPASSWD: /usr/local/sbin/docker-log-clean.sh
# security-check.sh: the nightly security pass
{{DASH_USER}} ALL=(root) NOPASSWD: /usr/local/bin/cloudflared update
{{DASH_USER}} ALL=(root) NOPASSWD: /usr/bin/systemctl restart cloudflared
{{DASH_USER}} ALL=(root) NOPASSWD: /usr/sbin/ufw status verbose
{{DASH_USER}} ALL=(root) NOPASSWD: /usr/sbin/ufw --force enable
# daily-routine.sh step 12: reboot after the routine when an update needs one
{{DASH_USER}} ALL=(root) NOPASSWD: /usr/bin/systemctl reboot
# intrusion-check.py: nightly rootkit scan
{{DASH_USER}} ALL=(root) NOPASSWD: /usr/bin/rkhunter --check --sk --rwo --nocolors
# daily-routine.sh: mount a data disk from /etc/fstab that is attached but not mounted
{{DASH_USER}} ALL=(root) NOPASSWD: /usr/bin/mount /mnt/*
